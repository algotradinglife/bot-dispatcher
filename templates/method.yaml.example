# method.yaml — 方法协议（PI 写契约时冻结，codex 审核，hash 绑定执行）
# 每研究 issue 契约必带。机器可读 — preflight 检查器校验。
# 参考：docs/delivery-improvement-2026-08-12.md 机制 1

protocol_version: 1

# 候选池（数据/模型空间边界）
candidate_pool:
  source: "冻结上游 issue 编号 + 工件"
  size: 55042
  description: "55,042 exact-N7 frozen candidates (label-blind, source-bound)"

# split 职责 — 模型/消融选择与 terminal 评估必须隔离
# codex 审核 (2026-08-12): selection_split != terminal_split 必须成立
splits:
  selection_split: "CV_2022"     # 模型/消融选择冻结处（只能在这选）
  terminal_split: "CV_2023"      # 只执行一次冻结后的 terminal decision
  holdout_isolated: true          # true=selection 数据不出现在 terminal 路径；false=记录剩余风险
  enforce_distinct: true          # 强制 selection != terminal (preflight 校验)

# 选择算法（防泄漏的声明）
selection_algorithm:
  method: "frozen selector, no terminal peeking"
  preregistered: true             # 选择决策必须预注册，禁止实现后发现回填
  seed: 42

# 指标定义 — 逐条 golden test 验证
metrics:
  - name: hhi
    definition: "aggregate by immutable ticket identity"
    golden_test: "tests/golden_metrics.py::test_hhi"
  - name: rolling
    definition: "5/10/20 with ¥100k time-zero anchor"
    golden_test: "tests/golden_metrics.py::test_rolling"
  - name: drawdown
    definition: "completed recovery vs terminal-open separated"
    golden_test: "tests/golden_metrics.py::test_drawdown"

# 板块拆解 — 探索/分析类工作按板块交付（每板块有交付标准）
# skill 引用 = analyst/engineer profile 已装的 data-science skills
# codex 审核 (2026-08-12): terminal_evaluation 只评估冻结结果,
# HPO/消融/比较全归 model_selection — 封死 terminal 二次选择泄漏
stages:
  - name: data_stats          # 数据统计（确定性审计）
    deliverable: "数据来源/schema/规模/缺失/异常/split 统计"
    skill: "eda-checklist"
    constraints: []
  - name: preprocessing       # 预处理（原始清洗，无监督）
    deliverable: "清洗/校验/转换规则 + 前后行数 + 丢弃原因"
    skill: "data-preprocessing"
    constraints: ["fail-fast 校验", "原子写"]
  - name: eda                 # 探索性分析（假设生成，不做模型选择）
    deliverable: "分布/聚类发现 + 假设 + 数据范围标记"
    skill: "eda-checklist"
    constraints: ["禁止 terminal 数据"]
  - name: feature_engineering # 特征工程
    deliverable: "特征 registry（来源列/可用时间/拟合范围）+ 泄漏测试"
    skill: "data-preprocessing"
    constraints: ["标签/未来信息不得进特征（REQ-E06）"]
  - name: model_selection     # 模型选择（HPO/消融/比较全在这）
    deliverable: "候选空间/折定义/seed/排名规则/tie-break/最终 pipeline hash"
    skill: "split-strategy"
    constraints: ["选择只用 selection_split", "terminal_access: forbidden"]
  - name: terminal_evaluation # 终期评估（只评估冻结结果，一次）
    deliverable: "冻结 pipeline hash + 一次性执行 receipt + 指标/区间/结论边界"
    skill: "experiment-tracking"
    constraints: ["terminal_access: exactly_once", "禁止 HPO/比较/调参"]

# 预算/停止规则
budget:
  max_runtime_h: 8
  max_cpu_hours: 64

# 必需工件 — preflight 检查存在性
required_artifacts:
  - "results/ledger.parquet"
  - "results/decision.csv"
  - "results/report.md"
  - "results/schema.yaml"

# schema 引用（机器可读 table schema 契约）
schema_ref: "results/schema.yaml"

# 执行 receipt 绑定（preflight 校验 hash 一致性）
receipt:
  bind_to: "results/manifest.sha256"
